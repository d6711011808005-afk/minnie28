rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTransaction(data, expectedUserId) {
      return data.userId == expectedUserId
        && (data.type == 'income' || data.type == 'expense')
        && data.amount is number
        && data.amount > 0
        && data.amount <= 1000000000
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 64
        && data.date is string
        && data.date.size() >= 8
        && data.date.size() <= 32
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 64))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidUserProfile(data, expectedUserId) {
      return data.userId == expectedUserId
        && (!('email' in data) || (data.email is string && data.email.size() <= 256))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('monthlyBudget' in data) || (data.monthlyBudget is number && data.monthlyBudget >= 0))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // User isolation rules
    match /users/{userId} {
      allow get, list: if isOwner(userId);

      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        
        allow create: if isOwner(userId)
          && isValidId(transactionId)
          && isValidTransaction(incoming(), userId)
          && incoming().keys().hasAll(['userId', 'type', 'amount', 'category', 'date']);

        allow update: if isOwner(userId)
          && isValidId(transactionId)
          && isValidTransaction(incoming(), userId)
          && incoming().userId == existing().userId;

        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      match /profile/{settingDoc} {
        allow get, list: if isOwner(userId);

        allow create, update: if isOwner(userId)
          && isValidId(settingDoc)
          && isValidUserProfile(incoming(), userId);

        allow delete: if isOwner(userId) && isValidId(settingDoc);
      }
    }

    // Health check collection for connectivity verification
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
